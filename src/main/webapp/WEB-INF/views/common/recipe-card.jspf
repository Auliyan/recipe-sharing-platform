<%-- One recipe card. Include it inside a <c:forEach var="r" ...> loop.
     <c:out> escapes user text so it cannot inject HTML/JavaScript (XSS protection). --%>
<div class="col-12 col-sm-6 col-lg-4">
  <div class="card recipe-card">
    <a class="recipe-media" href="${ctx}/recipe?id=${r.id}">
      <c:choose>
        <c:when test="${not empty r.imagePath}">
          <img class="recipe-img" src="<c:out value='${r.imagePath}' />" alt="<c:out value='${r.title}' />">
        </c:when>
        <c:otherwise>
          <div class="recipe-placeholder"><i class="bi bi-egg-fried"></i></div>
        </c:otherwise>
      </c:choose>
      <span class="badge category-badge"><c:out value="${r.category}" /></span>
    </a>
    <div class="card-body d-flex flex-column">
      <h5 class="card-title"><a href="${ctx}/recipe?id=${r.id}"><c:out value="${r.title}" /></a></h5>
      <p class="card-text text-muted small flex-grow-1"><c:out value="${r.description}" /></p>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="author-line"><i class="bi bi-person-circle"></i><c:out value="${r.authorName}" /></span>
        <a href="${ctx}/recipe?id=${r.id}" class="btn btn-outline-brand btn-sm">View <i class="bi bi-arrow-right ms-1"></i></a>
      </div>
    </div>
  </div>
</div>
