<%-- One recipe card. Include it inside a <c:forEach var="r" ...> loop.
     <c:out> escapes user text so it cannot inject HTML/JavaScript (XSS protection). --%>
<div class="col-12 col-sm-6 col-lg-4">
  <div class="card recipe-card">
    <c:choose>
      <c:when test="${not empty r.imagePath}">
        <img class="recipe-img" src="<c:out value='${r.imagePath}' />" alt="<c:out value='${r.title}' />">
      </c:when>
      <c:otherwise>
        <div class="recipe-placeholder">&#127858;</div>
      </c:otherwise>
    </c:choose>
    <div class="card-body d-flex flex-column">
      <span class="badge category-badge align-self-start mb-2"><c:out value="${r.category}" /></span>
      <h5 class="card-title"><a href="${ctx}/recipe?id=${r.id}"><c:out value="${r.title}" /></a></h5>
      <p class="card-text text-muted small flex-grow-1"><c:out value="${r.description}" /></p>
      <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">by <c:out value="${r.authorName}" /></small>
        <a href="${ctx}/recipe?id=${r.id}" class="btn btn-outline-brand btn-sm">View</a>
      </div>
    </div>
  </div>
</div>
